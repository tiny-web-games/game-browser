<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:strokeColor="@color/bg_card_stroke"
    app:strokeWidth="1.2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 游戏头部信息 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivGameIcon"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_floating_ball"
                android:padding="8dp"
                android:src="@drawable/ic_tank"
                app:tint="@color/primary_accent"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGameTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_title"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="钢铁咆哮 KV-44 (Tank)" />

                <TextView
                    android:id="@+id/tvGameBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_badge_offline"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="@string/badge_offline"
                    android:textColor="@color/badge_offline_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 删除/清除离线缓存按钮 (仅当离线就绪时可见) -->
            <ImageButton
                android:id="@+id/btnDeleteOffline"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="清除离线缓存"
                android:src="@drawable/ic_delete"
                android:visibility="gone"
                app:tint="#8894A3B8"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- 游戏简介 -->
        <TextView
            android:id="@+id/tvGameDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:minLines="2"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="横版坦克战斗游戏，重装轰击与物理弹道。支持全屏触摸与横屏游玩。" />

        <!-- 下载中进度条与进度百分比 (下载中才显示) -->
        <LinearLayout
            android:id="@+id/layoutDownloadProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="正在下载离线资源包并解压..."
                    android:textColor="@color/badge_online_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvDownloadProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/badge_online_text"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="45%" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressBarDownload"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="6dp"
                android:max="100"
                app:indicatorColor="@color/badge_online_text"
                app:trackColor="#334E89FF"
                app:trackCornerRadius="3dp"
                tools:progress="45" />
        </LinearLayout>

        <!-- 底部元数据与操作按钮栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvGameMeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="版本: v0.1.0 · 横屏" />

            <!-- 在线游玩按钮 (始终可用) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlayOnline"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="在线"
                android:textColor="@color/badge_online_text"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_globe"
                app:iconTint="@color/badge_online_text"
                app:strokeColor="@color/badge_online_text" />

            <!-- 离线保存按钮 (未下载时可见) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDownload"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="离线保存"
                android:textColor="@color/text_title"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_download"
                app:iconTint="@color/text_title" />

            <!-- 离线秒开按钮 (已下载时可见) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlayOffline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/primary_accent"
                android:text="离线秒开"
                android:textColor="#FFFFFF"
                android:visibility="gone"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_bolt"
                app:iconTint="#FFFFFF"
                tools:visibility="visible" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
